library(tidyverse)
library(tidygraph)
library(ggraph)
library(igraph)
load("reddit_graph.RData")
reddit_graph <- upgrade_graph(reddit_graph)
plot_data <- as_tbl_graph(reddit_graph) %>%
activate(nodes) %>%
mutate(influence = centrality_pagerank()) %>%
top_n(100, influence) %>%
mutate(node_label = Node) %>%
activate(edges) %>%
filter(NPosts > 2) %>%
mutate(sentiment_type = ifelse(AverageSentiment > 0.5, "Positiivne", "Negatiivne")) %>%
activate(nodes) %>%
#filter(!node_is_isolated()) %>%
mutate(community = as.factor(group_walktrap())) # Keyword
p <- ggraph(plot_data, layout = 'linear', circular = T) +
geom_edge_arc(
aes(color = sentiment_type, alpha = NPosts),
arrow = arrow(length = unit(1.5, "mm")),
end_cap = circle(3, "mm"),
show.legend = FALSE
) +
geom_node_point(aes(size = influence, color = community)) +
geom_node_text(
fontface = "bold",
aes(label = node_label),
data = ~ .x %>% arrange(desc(influence)) %>% slice_head(n = 10),
size = 3,
family = "sans",
angle = 0,
check_overlap = TRUE,
) +
geom_node_text(
aes(label = node_label),
data = ~ .x %>% arrange(influence) %>% slice_head(n = 40),
size = 1.6,
family = "sans",
angle = 0,
check_overlap = TRUE
) +
scale_size_continuous(range = c(6, 18)) +
scale_edge_color_manual(values = c("Positiivne" = "#27ae60", "Negatiivne" = "#e74c3c")) +
theme_graph() +
labs(title = "Redditi top 50 kogukondade võrgustik")
ggsave("reddit_graph.pdf", device = cairo_pdf, plot = p, width = 14, height = 10, dpi = 600)
p <- ggraph(plot_data, layout = 'linear', circular = T) +
geom_edge_arc(
aes(color = sentiment_type, alpha = NPosts),
arrow = arrow(length = unit(1.5, "mm")),
end_cap = circle(3, "mm"),
show.legend = FALSE
) +
geom_node_point(aes(size = influence, color = community)) +
geom_node_text(
fontface = "bold",
aes(label = node_label),
data = ~ .x %>% arrange(desc(influence)) %>% slice_head(n = 10),
size = 3,
family = "sans",
angle = 0,
check_overlap = TRUE,
) +
geom_node_text(
aes(label = node_label),
data = ~ .x %>% arrange(influence) %>% slice_head(n = 40),
size = 1.6,
family = "sans",
angle = 0,
check_overlap = TRUE
) +
scale_size_continuous(range = c(4, 10)) +
scale_edge_color_manual(values = c("Positiivne" = "#27ae60", "Negatiivne" = "#e74c3c")) +
theme_graph() +
labs(title = "Redditi top 50 kogukondade võrgustik")
