library(dplyr)
library(tidyr)
# 1. Kõige ohtlikum aastaeg läbi aastate (summaarselt)
# ---------------------------------------------------
ohtlikum_aastaeg <- graafiku_andmed %>%
group_by(Tüüp, Aastaaeg) %>%
summarise(Kokku_Arv = sum(Arv, na.rm = TRUE), .groups = 'drop') %>%
group_by(Tüüp) %>%
slice_max(order_by = Kokku_Arv, n = 1)
print("Kõige ohtlikum aastaeg tüüpide lõikes:")
print(ohtlikum_aastaeg)
# 2. Protsentuaalne jaotus aastaaja ja kuu lõikes
# -----------------------------------------------
# Esmalt eraldame kuupäevast kuu nime/numbri, kui seda veel pole
graafiku_andmed <- graafiku_andmed %>%
mutate(Kuu = format(as.Date(Kuupäev), "%m"))
protsendid <- graafiku_andmed %>%
# Arvutame summad tüübi, aastaaja ja kuu kohta läbi kõigi aastate
group_by(Tüüp, Aastaeg, Kuu) %>%
summarise(Arv_Perioodis = sum(Arv, na.rm = TRUE), .groups = 'drop') %>%
# Leiame protsendi: kui suur osa antud tüübi õnnetustest juhtus just sel kuul/aastaajal
group_by(Tüüp) %>%
mutate(Protsent = (Arv_Perioodis / sum(Arv_Perioodis)) * 100) %>%
ungroup()
# Teegid
library(dplyr)
library(tidyr)
# 1. Kõige ohtlikum aastaeg läbi aastate (summaarselt)
# ---------------------------------------------------
ohtlikum_aastaeg <- graafiku_andmed %>%
group_by(Tüüp, Aastaaeg) %>%
summarise(Kokku_Arv = sum(Arv, na.rm = TRUE), .groups = 'drop') %>%
group_by(Tüüp) %>%
slice_max(order_by = Kokku_Arv, n = 1)
print("Kõige ohtlikum aastaeg tüüpide lõikes:")
print(ohtlikum_aastaeg)
# 2. Protsentuaalne jaotus aastaaja ja kuu lõikes
# -----------------------------------------------
# Esmalt eraldame kuupäevast kuu nime/numbri, kui seda veel pole
graafiku_andmed <- graafiku_andmed %>%
mutate(Kuu = format(as.Date(Kuupäev), "%m"))
protsendid <- graafiku_andmed %>%
# Arvutame summad tüübi, aastaaja ja kuu kohta läbi kõigi aastate
group_by(Tüüp, Aastaaeg, Kuu) %>%
summarise(Arv_Perioodis = sum(Arv, na.rm = TRUE), .groups = 'drop') %>%
# Leiame protsendi: kui suur osa antud tüübi õnnetustest juhtus just sel kuul/aastaajal
group_by(Tüüp) %>%
mutate(Protsent = (Arv_Perioodis / sum(Arv_Perioodis)) * 100) %>%
ungroup()
# 3. Vali välja kõige ohtlikumad kuud/aastaajad (TOP 1 iga tüübi kohta)
# --------------------------------------------------------------------
koige_ohtlikumad_perioodid <- protsendid %>%
group_by(Tüüp) %>%
slice_max(order_by = Protsent, n = 1)
print("Kõige suurema osakaaluga (protsentuaalselt) kuu ja aastaaeg:")
print(koige_ohtlikumad_perioodid)
