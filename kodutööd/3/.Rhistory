library(tibble)
source("theme.r")
ac_clean <- ac %>% rownames_to_column(var = "QID")
plot_df <- as.data.frame(pf16_mat[, 1:3]) %>%
bind_cols(ar) %>%
pivot_longer(
cols = c("A1", "A2", "A3"),
names_to = "QID",
values_to = "Score"
)
plot_df <- plot_df %>%
left_join(ac_clean, by = "QID") %>%
mutate(
Country = recode(Country, "CA" = "Kanada", "IN" = "India"),
Gender = recode(Gender, "Male" = "Mehed", "Female" = "Naised")
) %>%
rename(QuestionGroup = QuestionGroupName)
ggplot(plot_df, aes(x = Age, y = Score, color = Gender)) +
geom_jitter(alpha = 0.5, width = 0.2, height = 0.2) +
facet_grid(Country ~ Question) +
labs(
x = "Vanus",
y = "Hinnang",
color = "Sugu"
) +
theme_swd() +
theme(
panel.spacing = unit(1.5, "lines"),
strip.text.y = element_text(angle = 0, hjust = 0, size = 8),
strip.text.x = element_text(size = 8),
legend.position = "bottom",
legend.title = element_blank()
)
load("reddit_graph.RData", verbose = T)
library(tidyverse)
library(tidygraph)
library(ggraph)
library(igraph)
load("reddit_graph.RData")
reddit_graph <- upgrade_graph(reddit_graph)
plot_data <- as_tbl_graph(reddit_graph) %>%
activate(nodes) %>%
mutate(influence = centrality_pagerank()) %>%
top_n(100, influence) %>%
mutate(node_label = Node) %>%
activate(edges) %>%
filter(NPosts > 2) %>%
mutate(sentiment_type = ifelse(AverageSentiment > 0.5, "Positiivne", "Negatiivne")) %>%
activate(nodes) %>%
#filter(!node_is_isolated()) %>%
mutate(community = as.factor(group_walktrap())) # Keyword
p <- ggraph(plot_data, layout = 'linear', circular = T) +
geom_edge_arc(
aes(color = sentiment_type, alpha = NPosts),
arrow = arrow(length = unit(1.5, "mm")),
end_cap = circle(3, "mm"),
show.legend = FALSE
) +
geom_node_point(aes(size = influence, color = community)) +
geom_node_text(
fontface = "bold",
aes(label = node_label),
#data = ~ .x %>% arrange(desc(influence)) %>% slice_head(n = 50),
size = 1,
family = "sans",
angle = 0,
check_overlap = TRUE,
) +
scale_size_continuous(range = c(4, 10)) +
scale_edge_color_manual(values = c("Positiivne" = "#27ae60", "Negatiivne" = "#e74c3c")) +
theme_graph() +
labs(title = "Redditi top 100 subredditi võrgustik")
ggsave("reddit_graph.pdf", device = cairo_pdf, plot = p, width = 14, height = 10, dpi = 600)
library(tidyverse)
library(sf)
library(osmdata)
library(leaflet)
library(ggrepel)
# install.packages("devtools")
# devtools::install_github("yutannihilation/ggsflabel")
library(ggsflabel)
clean_osm_data = function(x, retain_named = F){
for(i in names(x)){
if(str_detect(i, "osm") & !is.null(x[[i]])){
if(nrow(x[[i]]) == 0) { next}
if(retain_named){
x[[i]] = x[[i]] %>%
filter(!is.na(name))
}
# res = x[[i]] %>% keep(~ mean(is.na(na_if(.x, ""))) < 0.2)
res = x[[i]] %>% keep(function(.x) if(is.list(.x)){return(T)} else {mean(is.na(na_if(.x, ""))) < 0.2} )
if(("name" %in% colnames(x[[i]])) & (!("name" %in% colnames(res)))){
name = x[[i]] %>% as.data.frame() %>% select(name)
res = res %>% bind_cols(name)
}
x[[i]] = res
}
}
return(x)
}
tartu_bb = getbb("Tartu")
hooned = opq(tartu_bb) %>%
add_osm_feature(key = "building") %>%
osmdata_sf() %>%
unname_osmdata_sf() %>%
clean_osm_data()
